# ManageEngine ServiceDesk Plus (SDP) MCP server configuration.
# Copy to .env (or set in your MCP environment block) and fill in your values.

# Base URL of your SDP instance.
SDP_BASE_URL=https://assist.example.com

# API auth: either an API key or OAuth token.
# With an API key, requests send header TECHNICIAN_KEY.
SDP_API_KEY=your-technician-api-key

# OAuth mode (optional): token + email.
SDP_OAUTH_TOKEN=your-oauth-token
SDP_EMAIL=technician@example.com

# Optional CA bundle for proxies with private certs.
# NODE_EXTRA_CA_CERTS=/path/to/proxy-ca.pem